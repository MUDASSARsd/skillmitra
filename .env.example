# JeevikaMitra V38 — safe example only. Never commit a real key.
GEMINI_API_KEY=
LLM_PROVIDER=gemini
SKILLMITRA_ONLINE_MODEL=gemini-3.5-flash-lite

# Local app: local. Render/GitHub deployment: cloud.
SKILLMITRA_RUNTIME=local

# Same-origin frontend needs no custom CORS value. Use * only if another frontend calls this API.
CORS_ORIGINS=*

# Independence is ON by default. Leave this at 0 so stale paths from older
# JeevikaMitra folders can never become runtime dependencies.
ALLOW_EXTERNAL_MODEL_PATHS=0

# Optional free-form local NLU. Deterministic offline extraction still works if Ollama is absent.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma3:4b
OLLAMA_FAST_MODEL=gemma3:1b
OLLAMA_PREFER_FAST=1
OLLAMA_KEEP_ALIVE=30m
OLLAMA_NUM_PREDICT=128
OLLAMA_NUM_CTX=1536
OLLAMA_ALLOW_RULE_FALLBACK=1

# NQR semantic cache is inside this project.
NQR_EMBED_MODEL=embeddinggemma
NQR_SEMANTIC_CACHE=data/nqr_semantic_embeddings.npz
NQR_SEMANTIC_MIN_COSINE=0.20

# Advanced legacy engines only. Ignored unless ALLOW_EXTERNAL_MODEL_PATHS=1.
PARAKEET_MODEL_DIR=
WHISPER_CPP_BIN=
WHISPER_MODEL_PATH=
PIPER_TELUGU_MODEL=
PIPER_TELUGU_CONFIG=
PIPER_HINDI_MODEL=
PIPER_HINDI_CONFIG=
